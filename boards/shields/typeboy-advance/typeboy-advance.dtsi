#include <physical_layouts.dtsi>
#include <dt-bindings/zmk/matrix_transform.h>
#include <dt-bindings/led/led.h>

// Define a pinctrl for the RGB LEDs.
&pinctrl {
    spi3_default: spi3_default {
        group1 {
            psels = <NRF_PSEL(SPIM_MOSI, 1, 0)>;
        };
    };

    spi3_sleep: spi3_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_MOSI, 1, 0)>;
            low-power-enable;
        };
    };
};

// RGB LEDs. Connected to Pin D26/P1.00
&spi3 {
    compatible = "nordic,nrf-spim";
    status = "okay";

    pinctrl-0 = <&spi3_default>;
    pinctrl-1 = <&spi3_sleep>;
    pinctrl-names = "default", "sleep";

    led_strip: ws2812@0 {
        compatible = "worldsemi,ws2812-spi";

        /* SPI */
        reg = <0>; /* ignored, but necessary for SPI bindings */
        spi-max-frequency = <4000000>;

        /* WS2812 */
        chain-length = <48>; /* number of LEDs */
        spi-one-frame = <0x70>;
        spi-zero-frame = <0x40>;
        color-mapping = <LED_COLOR_ID_GREEN
                         LED_COLOR_ID_RED
                         LED_COLOR_ID_BLUE>;
    };
};

// Display settings.
&cart_spi {
    status = "okay";

    cs-gpios = <&cart 23 GPIO_ACTIVE_HIGH>;
	ls0xx: ls0xx@0 {
		compatible = "sharp,ls0xx";
		label = "DISPLAY";
		spi-max-frequency = <2000000>;
		reg = <0>;
		width = <160>;
		height = <68>;
	};
};

&cart_serial { status = "disabled"; };

&typeboy_advance_layout {
    transform = <&default_transform>;
};

/ {
    typeboy_advance_layout: typeboy_advance_layout {
        compatible = "zmk,physical-layout";
        display-name = "TypeBoy Advance";

        keys  //                     w   h    x    y     rot    rx    ry
            = <&key_physical_attrs 100 100    0   60       0     0     0>
            , <&key_physical_attrs 100 100  100   40       0     0     0>
            , <&key_physical_attrs 100 100  200   20       0     0     0>
            , <&key_physical_attrs 100 100  300    0       0     0     0>
            , <&key_physical_attrs 100 100  400   20       0     0     0>
            , <&key_physical_attrs 100 100  500   31       0     0     0>
            , <&key_physical_attrs 100 100  880   31       0     0     0>
            , <&key_physical_attrs 100 100  980   20       0     0     0>
            , <&key_physical_attrs 100 100 1080    0       0     0     0>
            , <&key_physical_attrs 100 100 1180   20       0     0     0>
            , <&key_physical_attrs 100 100 1280   40       0     0     0>
            , <&key_physical_attrs 100 100 1380   60       0     0     0>
            , <&key_physical_attrs 100 100    0  160       0     0     0>
            , <&key_physical_attrs 100 100  100  140       0     0     0>
            , <&key_physical_attrs 100 100  200  120       0     0     0>
            , <&key_physical_attrs 100 100  300  100       0     0     0>
            , <&key_physical_attrs 100 100  400  120       0     0     0>
            , <&key_physical_attrs 100 100  500  131       0     0     0>
            , <&key_physical_attrs 100 100  880  131       0     0     0>
            , <&key_physical_attrs 100 100  980  120       0     0     0>
            , <&key_physical_attrs 100 100 1080  100       0     0     0>
            , <&key_physical_attrs 100 100 1180  120       0     0     0>
            , <&key_physical_attrs 100 100 1280  140       0     0     0>
            , <&key_physical_attrs 100 100 1380  160       0     0     0>
            , <&key_physical_attrs 100 100    0  260       0     0     0>
            , <&key_physical_attrs 100 100  100  240       0     0     0>
            , <&key_physical_attrs 100 100  200  220       0     0     0>
            , <&key_physical_attrs 100 100  300  200       0     0     0>
            , <&key_physical_attrs 100 100  400  220       0     0     0>
            , <&key_physical_attrs 100 100  500  231       0     0     0>
            , <&key_physical_attrs 100 100  880  231       0     0     0>
            , <&key_physical_attrs 100 100  980  220       0     0     0>
            , <&key_physical_attrs 100 100 1080  200       0     0     0>
            , <&key_physical_attrs 100 100 1180  220       0     0     0>
            , <&key_physical_attrs 100 100 1280  240       0     0     0>
            , <&key_physical_attrs 100 100 1380  260       0     0     0>
            , <&key_physical_attrs 100 100  174  353       0     0     0>
            , <&key_physical_attrs 100 100  274  333       0     0     0>
            , <&key_physical_attrs 100 100  374  353       0     0     0>
            , <&key_physical_attrs 100 100  485  368    1500   535   418>
            , <&key_physical_attrs 150 100  576  389 (-6000)   651   439>
            , <&key_physical_attrs 150 100  754  389    6000   829   439>
            , <&key_physical_attrs 100 100  895  368 (-1500)   945   418>
            , <&key_physical_attrs 100 100 1007  353       0     0     0>
            , <&key_physical_attrs 100 100 1107  333       0     0     0>
            , <&key_physical_attrs 100 100 1207  353       0     0     0>
            ;
    };
    
    chosen {
        zmk,kscan = &kscan0;
        zmk,physical-layout = &typeboy_advance_layout;
		zephyr,display = &ls0xx;
        zmk,underglow = &led_strip;
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <12>;
        rows = <4>;

        map = <
            RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4) RC(3,5) RC(3,6) RC(3,7) RC(3,8) RC(3,9) RC(3,10) RC(3,11)
            RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5) RC(2,6) RC(2,7) RC(2,8) RC(2,9) RC(2,10) RC(2,11)
            RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5) RC(1,6) RC(1,7) RC(1,8) RC(1,9) RC(1,10) RC(1,11)
                    RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5) RC(0,6) RC(0,7) RC(0,8) RC(0,9) RC(0,10)
        >;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        wakeup-source;

        diode-direction = "col2row";

        row-gpios
            = <&cart 9 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&cart 8 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&cart 7 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&cart 6 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            ;
    };
};